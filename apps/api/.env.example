# 관리 API 환경변수
PORT=8090
HOST=127.0.0.1
# 게임 서버와 같은 DB 파일(SQLite) — 게임 저장소 migrations 012_game_data 적용된 것
GAME_DB=/srv/gate-hero/rift.db
# 운영툴 자체 DB(관리자 계정·감사)
ADMIN_DB=/srv/gate-hero-admin/admin.db
# 토큰 서명 키(운영 필수, 32바이트 이상 무작위)
ADMIN_SECRET=
# 릴리스 뒤 게임 서버에 새 데이터를 읽게 알림 — 게임 서버 ADMIN_TOKEN과 같은 값
GAME_SERVER_URL=http://127.0.0.1:8080
GAME_ADMIN_TOKEN=
# 빌드된 관리 화면 폴더(같은 주소로 내보냄)
WEB_DIR=../web/dist
